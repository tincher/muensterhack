<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barrierefreie Route</title>
    <script src="https://unpkg.com/leaflet@1.9/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9/dist/leaflet.css" />
    <style>
      html, body {
        height: 100%;
        padding: 0;
        margin: 0;
      }
      #map {
        /* configure the size of the map */
        width: 100%;
        height: 100%;
      }

      /* Search panel */
      .search {
        position: absolute;
        top: 10px;
        left: 56px;
        z-index: 1000;
        width: 300px;
        padding: 16px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
        font-family: system-ui, -apple-system, sans-serif;
      }
      .search h1 {
        font-size: 18px;
        margin: 0 0 8px;
      }
      .search label {
        display: block;
        margin: 10px 0 4px;
        font-size: 14px;
        font-weight: 600;
        color: #222;
      }
      .search input {
        width: 100%;
        box-sizing: border-box;
        padding: 10px 12px;
        font-size: 16px;
        border: 2px solid #767676;
        border-radius: 10px;
      }
      .search button {
        width: 100%;
        margin-top: 14px;
        padding: 12px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background: #2f6fed;
        border: none;
        border-radius: 10px;
        cursor: pointer;
      }
      .search button:hover {
        background: #1f57c9;
      }
      .search input:focus-visible,
      .search button:focus-visible {
        outline: 3px solid #ffbf47;
        outline-offset: 2px;
      }
      .search .error {
        margin: 12px 0 0;
        padding: 10px;
        font-size: 14px;
        color: #8a1c14;
        background: #fdecea;
        border-radius: 8px;
      }

      /* Small screens: panel at the bottom */
      @media (max-width: 700px) {
        .search {
          top: auto;
          bottom: 24px;
          left: 10px;
          right: 10px;
          width: auto;
        }
      }
    </style>
  </head>
  <body>
    <form class="search" method="get" action="/" role="search" aria-label="Route suchen">
      <h1>Barrierefreie Route</h1>

      <label for="start">Start</label>
      <input id="start" name="start" type="text" value="{{ start|e }}"
             placeholder="z. B. Hauptbahnhof Münster" autocomplete="off" required>

      <label for="destination">Ziel</label>
      <input id="destination" name="destination" type="text" value="{{ destination|e }}"
             placeholder="z. B. Domplatz Münster" autocomplete="off" required>

      <button type="submit">Route suchen</button>

      {% if error %}
        <p class="error" role="alert">{{ error|e }}</p>
      {% endif %}
    </form>

    <div id="map"></div>
    <script>
     {{leaflet_code}}
    </script>
  </body>
</html>