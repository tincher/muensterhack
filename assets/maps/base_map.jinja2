<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Münster · Barrierefreie Route</title>
    <link rel="icon" href="data:,">
    <script src="https://unpkg.com/leaflet@1.9/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9/dist/leaflet.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap">
    <style>
      /* Colours taken from the Access Münster logo (all text combinations meet WCAG AA) */
      :root {
        --navy: #132933;
        --petrol: #2b5d79;
        --yellow: #e6af44;
        --green-light: #e0f2dc;
        --border: #5b6b73;
      }

      html, body {
        height: 100%;
        margin: 0;
        font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
        color: var(--navy);
      }
      #map { width: 100%; height: 100%; }

      /* Search card */
      .search {
        position: absolute;
        /* below the header bar and the filter bar of the team */
        top: calc(var(--app-header-height, 0px) + var(--filter-bar-height, 0px) + 22px);
        left: 56px;
        /* below the filter bar (z-index 999), so its drop-down menus open on top of this card */
        z-index: 998;
        width: 320px;
        box-sizing: border-box;
        padding: 16px 16px 18px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(19, 41, 51, 0.18);
      }

      /* Label row: label on the left, optional small action on the right */
      .label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 16px 0 8px;
      }
      .label-row:first-of-type { margin-top: 0; }
      .locate-row + .label-row { margin-top: 8px; }
      .label-row label {
        font-size: 15px;
        font-weight: 700;
      }

      .search input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        height: 48px;
        padding: 0 14px;
        font: inherit;
        font-size: 17px;
        color: var(--navy);
        border: 2px solid var(--border);
        border-radius: 12px;
        background: #fff;
      }
      .search input::placeholder { color: var(--border); }
      .search input:focus { border-color: var(--petrol); }

      /* Small text buttons with icon ("Meinen Standort verwenden") */
      .text-button {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 36px;
        padding: 0;
        margin: 0;
        font: inherit;
        font-size: 15px;
        font-weight: 700;
        color: var(--petrol);
        background: transparent;
        border: none;
        border-radius: 999px;
        cursor: pointer;
      }
      .text-button:hover { color: var(--navy); text-decoration: underline; }
      .text-button svg { flex-shrink: 0; }
      .locate-row { margin-top: 8px; }

      .submit {
        width: 100%;
        height: 50px;
        margin-top: 20px;
        font: inherit;
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        background: var(--petrol);
        border: none;
        border-radius: 12px;
        cursor: pointer;
      }
      .submit:hover { background: var(--navy); }

      /* Visible keyboard focus: yellow ring with a navy edge */
      .search input:focus-visible,
      .search button:focus-visible,
      .search summary:focus-visible {
        outline: 3px solid var(--yellow);
        outline-offset: 2px;
        box-shadow: 0 0 0 5px var(--navy);
      }

      .error {
        margin: 12px 0 0;
        padding: 10px 12px;
        font-size: 15px;
        color: #8a1c14;
        background: #fdecea;
        border-radius: 10px;
      }

      /* Route result (only after a search) */
      .result {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e4ebee;
      }
      .result .time { font-size: 24px; font-weight: 700; margin-right: 6px; }

      /* Summary at the top of the result: time, distance, "Start → Ziel" and the "Ändern" button */
      .result-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
      }
      .result-head .time,
      .result-head .distance { white-space: nowrap; }
      .result-head .trip {
        margin: 2px 0 0;
        font-size: 15px;
        line-height: 1.35;
        overflow-wrap: anywhere;
      }
      .edit-button {
        flex-shrink: 0;
        min-height: 44px;
        padding: 0 16px;
        font: inherit;
        font-size: 15px;
        font-weight: 700;
        color: var(--petrol);
        background: #fff;
        border: 2px solid var(--petrol);
        border-radius: 999px;
        cursor: pointer;
      }
      .edit-button:hover { background: var(--green-light); }
      .edit-button[hidden] { display: none; }

      /* After a search the input fields are folded away (only when JavaScript runs) */
      .search.is-collapsed .fields { display: none; }
      .search[hidden] { display: none; }
      .search.is-collapsed .result {
        margin-top: 0;
        padding-top: 0;
        border-top: none;
      }
      .result .badge {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 12px 0 0;
        padding: 10px 14px;
        border-radius: 12px;
        background: var(--green-light);
        font-size: 14px;
        font-weight: 700;
        line-height: 1.4;
      }
      .result .badge svg { flex-shrink: 0; color: #2f7a3a; }
      .result .parking-hint {
        margin: 10px 0 0;
        font-size: 14px;
        line-height: 1.4;
      }
      .result summary {
        margin-top: 8px;
        min-height: 44px;
        display: flex;
        align-items: center;
        color: var(--petrol);
        font-weight: 700;
        cursor: pointer;
      }
      /* Directions: numbers in their own column, so 10, 11, ... are never cut off
         and long lines wrap under the text instead of under the number */
      .result ol {
        margin: 0;
        padding: 0 4px 0 0;
        list-style: none;
        counter-reset: step;
        max-height: 220px;
        overflow-y: auto;
        font-size: 15px;
        line-height: 1.45;
      }
      .result li {
        counter-increment: step;
        display: grid;
        grid-template-columns: 2em 1fr;
        column-gap: 8px;
        padding: 6px 0;
        border-bottom: 1px solid #e4ebee;
      }
      .result li:last-child { border-bottom: none; }
      .result li::before {
        content: counter(step) ".";
        text-align: right;
        font-weight: 700;
        color: var(--petrol);
        font-variant-numeric: tabular-nums;
      }

      .sr-only {
        position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip: rect(0 0 0 0); white-space: nowrap;
      }

      /* Header bar: logo on the left, map style buttons (Stadtplan/Natur/Satellit) on the right */
      .app-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 0 16px;
        box-sizing: border-box;
      }
      .app-header > :first-child {
        margin-left: 0;
        margin-right: auto;
      }
      @media (max-width: 480px) {
        .app-header { padding: 0 10px; gap: 8px; }
        .app-header img { max-width: 110px; height: auto; }
      }

      /* Map controls (zoom +/- and Stadtplan/Natur/Satellit) start below the header and the
         filter bar, and the scale bar / attribution sit above the "Karte / Liste" bar,
         so nothing is hidden behind the fixed bars of the app */
      .leaflet-top {
        top: calc(var(--app-header-height, 0px) + 10px + var(--filter-bar-height, 0px));
      }
      .leaflet-bottom {
        bottom: var(--view-switcher-height, 0px);
      }

      /* Leaflet attribution (bottom right): readable contrast */
      .leaflet-container .leaflet-control-attribution {
        background: rgba(255, 255, 255, 0.95);
        color: #132933;
        font-size: 12px;
        font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
      }
      .leaflet-container .leaflet-control-attribution a {
        color: #2b5d79;
        text-decoration: underline;
      }

      /* Small screens (phone): card at the bottom, always above the "Karte / Liste" bar */
      @media (max-width: 700px) {
        .search {
          top: auto;
          /* leaves a small gap for the map attribution (© OpenStreetMap) above the bar */
          bottom: calc(var(--view-switcher-height, 64px) + 26px);
          left: 10px;
          right: 10px;
          width: auto;
          max-height: calc(100% - var(--view-switcher-height, 64px) - var(--app-header-height, 0px) - var(--filter-bar-height, 0px) - 40px);
          overflow-y: auto;
          padding: 14px 16px 14px;
        }
        /* the scale bar would sit behind the card on a phone */
        .leaflet-control-scale { display: none; }
        .result .badge { margin-top: 10px; padding: 8px 12px; font-size: 13px; }
        .result .badge-detail { display: none; }
        .result .parking-hint { margin-top: 8px; }
        .result summary { margin-top: 4px; }
        .result ol { max-height: 34vh; }
      }
    </style>
  </head>
  <body>
    <form class="search" method="get" action="/" role="search" aria-label="Barrierefreie Route suchen">
      <h1 class="sr-only">Access Münster – barrierefreie Route</h1>
      <p id="status" class="sr-only" aria-live="polite"></p>

      <div class="fields" id="search-fields">
      <div class="label-row">
        <label for="start">Start</label>
      </div>
      <input id="start" name="start" type="text" value="{{ start|e }}"
             placeholder="z. B. Hauptbahnhof" autocomplete="street-address" required>
      <input type="hidden" id="start_coords" name="start_coords" value="{{ start_coords|default('', true)|e }}">
      <div class="locate-row">
        <button type="button" id="locate" class="text-button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 3 3 10.5l7.5 3 3 7.5L21 3z"/></svg>
          <span id="locate-text">Meinen Standort verwenden</span>
        </button>
      </div>

      <div class="label-row">
        <label for="destination">Ziel</label>
      </div>
      <input id="destination" name="destination" type="text" value="{{ destination|e }}"
             placeholder="z. B. Domplatz" autocomplete="street-address" required>

      <button type="submit" class="submit">Route suchen</button>
      </div>

      {% if error %}
        <p class="error" role="alert">{{ error|e }}</p>
      {% endif %}

      {% if route_info %}
        <div class="result" role="status">
          {% set hours = route_info.duration_min // 60 %}
          {% set minutes = route_info.duration_min % 60 %}
          <div class="result-head">
            <div>
              <span class="time">{% if hours %}{{ hours }} Std {{ minutes }} Min{% else %}{{ minutes }} Min{% endif %}</span>
              <span class="distance">{{ ("%.1f"|format(route_info.distance_km))|replace(".", ",") }} km</span>
              <p class="trip">{{ start|e }} → {{ destination|e }}</p>
            </div>
            <button type="button" id="edit-search" class="edit-button"
                    aria-controls="search-fields" aria-expanded="true" hidden>Ändern</button>
          </div>
          <p class="badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
            <span>Rollstuhlgerecht<span class="badge-detail">: ohne Treppen, nicht steiler als 6 %</span></span>
          </p>
          {% if route_info.parking %}
            <p class="parking-hint">
              <strong>Behindertenparkplatz am Ziel:</strong>
              {% for spot in route_info.parking %}{{ spot.name|e }} ({{ spot.distance_m }} m){% if not loop.last %}, {% endif %}{% endfor %}
            </p>
          {% elif route_info.parking is defined %}
            <p class="parking-hint">Kein Behindertenparkplatz im Umkreis von {{ parking_radius_m }} m um das Ziel.</p>
          {% endif %}
          <details>
            <summary>Wegbeschreibung anzeigen</summary>
            <ol role="list">
              {% for step in route_info.steps %}
                {% set text = step|striptags|trim %}
                <li>{{ text[:1]|upper }}{{ text[1:] }}</li>
              {% endfor %}
            </ol>
          </details>
        </div>
      {% endif %}
    </form>

    <div id="map"></div>
    {% include "header_bar.jinja2" %}
    {% include "waypoint_panel.jinja2" %}
    {% include "filter_bar.jinja2" %}
    {% include "list_view.jinja2" %}
    {% include "view_switcher.jinja2" %}
    <script>
      (function () {
        var start = document.getElementById('start');
        var destination = document.getElementById('destination');
        var coords = document.getElementById('start_coords');
        var status = document.getElementById('status');
        var locateText = document.getElementById('locate-text');
        var defaultLocateText = locateText.textContent;

        function say(message) {
          status.textContent = message;
        }

        // "Meinen Standort verwenden": fill the start field with the current position
        document.getElementById('locate').addEventListener('click', function () {
          if (!navigator.geolocation) {
            say('Standort wird von diesem Browser nicht unterstützt.');
            return;
          }
          locateText.textContent = 'Standort wird ermittelt …';
          say('Standort wird ermittelt …');
          navigator.geolocation.getCurrentPosition(function (pos) {
            coords.value = pos.coords.latitude.toFixed(6) + ',' + pos.coords.longitude.toFixed(6);
            start.value = 'Mein Standort';
            locateText.textContent = defaultLocateText;
            say('Dein Standort wurde als Start eingetragen.');
            destination.focus();
          }, function () {
            locateText.textContent = defaultLocateText;
            say('Standort konnte nicht ermittelt werden. Bitte Start eintippen.');
          }, {enableHighAccuracy: true, timeout: 10000});
        });

        // Typing a new start address forgets the stored position
        start.addEventListener('input', function () { coords.value = ''; });

        // "Liste" view: hide the search card, "Karte" view: show it again.
        // Works by watching the list view of the team, so the view switcher itself does not need to change.
        var searchCard = document.querySelector('.search');
        var listView = document.getElementById('waypoint-list-view');
        var mapElement = document.getElementById('map');
        function isShown(element) {
          return !!element && element.getClientRects().length > 0;
        }
        function syncSearchCard() {
          var listIsOpen = isShown(listView) || !isShown(mapElement);
          searchCard.hidden = listIsOpen;
        }
        if (window.MutationObserver) {
          var observer = new MutationObserver(syncSearchCard);
          [document.body, listView, mapElement].forEach(function (element) {
            if (element) {
              observer.observe(element, {attributes: true, attributeFilter: ['hidden', 'class', 'style']});
            }
          });
        }
        document.addEventListener('click', function (event) {
          if (event.target.closest('.view-switcher')) {
            setTimeout(syncSearchCard, 0);
          }
        });
        window.addEventListener('load', syncSearchCard);

        // After a search: fold the input fields away so the route is visible.
        // "Ändern" opens them again. Without JavaScript everything simply stays open.
        var form = document.querySelector('.search');
        var editButton = document.getElementById('edit-search');
        if (editButton) {
          editButton.hidden = false;
          var setCollapsed = function (collapsed) {
            form.classList.toggle('is-collapsed', collapsed);
            editButton.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            editButton.textContent = collapsed ? 'Ändern' : 'Einklappen';
          };
          setCollapsed(true);
          editButton.addEventListener('click', function () {
            var collapsed = form.classList.contains('is-collapsed');
            setCollapsed(!collapsed);
            if (collapsed) {
              form.scrollTop = 0;
              start.focus();
            }
          });
        }
      })();

     {{leaflet_code}}
    </script>
  </body>
</html>
