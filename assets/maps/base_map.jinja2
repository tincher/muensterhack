<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Münster · Barrierefreie Route</title>
    <link rel="icon" href="data:,">
    <script src="https://unpkg.com/leaflet@1.9/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9/dist/leaflet.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap">
    <style>
      /* Colours taken from the Access Münster logo (all text combinations meet WCAG AA) */
      :root {
        --navy: #132933;
        --petrol: #2b5d79;
        --yellow: #e6af44;
        --green-light: #e0f2dc;
        --border: #5b6b73;
      }

      html, body {
        height: 100%;
        margin: 0;
        font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
        color: var(--navy);
      }
      #map { width: 100%; height: 100%; }

      /* Search card */
      .search {
        position: absolute;
        top: 12px;
        left: 56px;
        z-index: 1000;
        width: 320px;
        box-sizing: border-box;
        padding: 16px 16px 18px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(19, 41, 51, 0.18);
      }

      /* Label row: label on the left, optional small action on the right */
      .label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 16px 0 8px;
      }
      .label-row:first-of-type { margin-top: 0; }
      .locate-row + .label-row { margin-top: 8px; }
      .label-row label {
        font-size: 15px;
        font-weight: 700;
      }

      .search input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        height: 48px;
        padding: 0 14px;
        font: inherit;
        font-size: 17px;
        color: var(--navy);
        border: 2px solid var(--border);
        border-radius: 12px;
        background: #fff;
      }
      .search input::placeholder { color: var(--border); }
      .search input:focus { border-color: var(--petrol); }

      /* Small text buttons with icon ("Meinen Standort verwenden") */
      .text-button {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 36px;
        padding: 0;
        margin: 0;
        font: inherit;
        font-size: 15px;
        font-weight: 700;
        color: var(--petrol);
        background: transparent;
        border: none;
        border-radius: 999px;
        cursor: pointer;
      }
      .text-button:hover { color: var(--navy); text-decoration: underline; }
      .text-button svg { flex-shrink: 0; }
      .locate-row { margin-top: 8px; }

      .submit {
        width: 100%;
        height: 50px;
        margin-top: 20px;
        font: inherit;
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        background: var(--petrol);
        border: none;
        border-radius: 12px;
        cursor: pointer;
      }
      .submit:hover { background: var(--navy); }

      /* Visible keyboard focus: yellow ring with a navy edge */
      .search input:focus-visible,
      .search button:focus-visible,
      .search summary:focus-visible {
        outline: 3px solid var(--yellow);
        outline-offset: 2px;
        box-shadow: 0 0 0 5px var(--navy);
      }

      .error {
        margin: 12px 0 0;
        padding: 10px 12px;
        font-size: 15px;
        color: #8a1c14;
        background: #fdecea;
        border-radius: 10px;
      }

      /* Route result (only after a search) */
      .result {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e4ebee;
      }
      .result .time { font-size: 24px; font-weight: 700; margin-right: 6px; }
      .result .badge {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 12px 0 0;
        padding: 10px 14px;
        border-radius: 12px;
        background: var(--green-light);
        font-size: 14px;
        font-weight: 700;
        line-height: 1.4;
      }
      .result .badge svg { flex-shrink: 0; color: #2f7a3a; }
      .result summary {
        margin-top: 8px;
        min-height: 44px;
        display: flex;
        align-items: center;
        color: var(--petrol);
        font-weight: 700;
        cursor: pointer;
      }
      .result ol {
        margin: 0;
        padding-left: 20px;
        max-height: 220px;
        overflow-y: auto;
        font-size: 15px;
        line-height: 1.5;
      }

      .sr-only {
        position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip: rect(0 0 0 0); white-space: nowrap;
      }

      /* Leaflet attribution (bottom right): readable contrast */
      .leaflet-container .leaflet-control-attribution {
        background: rgba(255, 255, 255, 0.95);
        color: #132933;
        font-size: 12px;
        font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
      }
      .leaflet-container .leaflet-control-attribution a {
        color: #2b5d79;
        text-decoration: underline;
      }

      /* Small screens: card at the bottom over the full width */
      @media (max-width: 700px) {
        .search { top: auto; bottom: 20px; left: 10px; right: 10px; width: auto; }
      }
    </style>
  </head>
  <body>
    <form class="search" method="get" action="/" role="search" aria-label="Barrierefreie Route suchen">
      <h1 class="sr-only">Access Münster – barrierefreie Route</h1>
      <p id="status" class="sr-only" aria-live="polite"></p>

      <div class="label-row">
        <label for="start">Start</label>
      </div>
      <input id="start" name="start" type="text" value="{{ start|e }}"
             placeholder="z. B. Hauptbahnhof" autocomplete="street-address" required>
      <input type="hidden" id="start_coords" name="start_coords" value="{{ start_coords|default('', true)|e }}">
      <div class="locate-row">
        <button type="button" id="locate" class="text-button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 3 3 10.5l7.5 3 3 7.5L21 3z"/></svg>
          <span id="locate-text">Meinen Standort verwenden</span>
        </button>
      </div>

      <div class="label-row">
        <label for="destination">Ziel</label>
      </div>
      <input id="destination" name="destination" type="text" value="{{ destination|e }}"
             placeholder="z. B. Domplatz" autocomplete="street-address" required>

      <button type="submit" class="submit">Route suchen</button>

      {% if error %}
        <p class="error" role="alert">{{ error|e }}</p>
      {% endif %}

      {% if route_info %}
        <div class="result" role="status">
          {% set hours = route_info.duration_min // 60 %}
          {% set minutes = route_info.duration_min % 60 %}
          <span class="time">{% if hours %}{{ hours }} Std {{ minutes }} Min{% else %}{{ minutes }} Min{% endif %}</span>
          <span>{{ ("%.1f"|format(route_info.distance_km))|replace(".", ",") }} km</span>
          <p class="badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
            Rollstuhlgerecht: ohne Treppen, nicht steiler als 6 %
          </p>
          <details>
            <summary>Wegbeschreibung anzeigen</summary>
            <ol>
              {% for step in route_info.steps %}
                <li>{{ step|striptags }}</li>
              {% endfor %}
            </ol>
          </details>
        </div>
      {% endif %}
    </form>

    <div id="map"></div>
    <script>
      (function () {
        var start = document.getElementById('start');
        var destination = document.getElementById('destination');
        var coords = document.getElementById('start_coords');
        var status = document.getElementById('status');
        var locateText = document.getElementById('locate-text');
        var defaultLocateText = locateText.textContent;

        function say(message) {
          status.textContent = message;
        }

        // "Meinen Standort verwenden": fill the start field with the current position
        document.getElementById('locate').addEventListener('click', function () {
          if (!navigator.geolocation) {
            say('Standort wird von diesem Browser nicht unterstützt.');
            return;
          }
          locateText.textContent = 'Standort wird ermittelt …';
          say('Standort wird ermittelt …');
          navigator.geolocation.getCurrentPosition(function (pos) {
            coords.value = pos.coords.latitude.toFixed(6) + ',' + pos.coords.longitude.toFixed(6);
            start.value = 'Mein Standort';
            locateText.textContent = defaultLocateText;
            say('Dein Standort wurde als Start eingetragen.');
            destination.focus();
          }, function () {
            locateText.textContent = defaultLocateText;
            say('Standort konnte nicht ermittelt werden. Bitte Start eintippen.');
          }, {enableHighAccuracy: true, timeout: 10000});
        });

        // Typing a new start address forgets the stored position
        start.addEventListener('input', function () { coords.value = ''; });
      })();

     {{leaflet_code}}
    </script>
  </body>
</html>
