{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "start server",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "src.server",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run"
            ],
            "jinja": true
        },
        {
            "name": "routing",
            "type": "debugpy",
            "request": "launch",
            "module": "src.routing",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "park_sensor",
            "type": "debugpy",
            "request": "launch",
            "module": "src.park_sensor",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "db",
            "type": "debugpy",
            "request": "launch",
            "module": "src.db_handler",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "fill db",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.fill_db",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "update db",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.update_db",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "update live data",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.update_live_data",
            "envFile": "${workspaceFolder}/.env"
        },
    ]
}