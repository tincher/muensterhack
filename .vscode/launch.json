{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "routing",
            "type": "debugpy",
            "request": "launch",
            "module": "src.routing",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "start server",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "src.server",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run"
            ],
            "jinja": true
        },
    ]
}